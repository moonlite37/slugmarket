{
  "name": "slugmarket_admin",
  "version": "0.1.0",
  "dependencies": {
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jscpd": "^4.0.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint src/**/* --fix",
    "cpd": "jscpd src test --silent",
    "start": "next start",
    "pretest": "(npm run lint) && (npm run cpd)",
    "test": "vitest run --dir test --no-file-parallelism --testTimeout=3000 --coverage"
  }
