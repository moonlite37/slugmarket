{
  "compilerOptions": {
    "target": "es2024",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./build",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    "esModuleInterop": true,

    "resolveJsonModule": true,
    "removeComments": true,        

    "typeRoots": ["./src/types", "./node_modules/@types"],
    "paths": {
      "@src/*": ["./src/*"]
    }
  },

  "include": ["src"],

  "exclude": [
    "vite.config.ts",
  ],
}
