{
	"entryFile": "src/app.ts",
	"noImplicitAdditionalProperties": "throw-on-extras",
	"controllerPathGlobs": ["src/**/controller.ts"],
	"spec": {
		"outputDirectory": "build",
		"specVersion": 3,
		"schemes": ["http"],
		"basePath": "/api/v0",
		"securityDefinitions": {
			"bearer": {
				"type": "http",
				"scheme": "bearer"
			}
		}
	},
	"routes": {
		"routesDir": "build",
		"authenticationModule": "./src/corp/express.ts"
	}
}
