{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/**/controller.ts"],
  "spec": {
    "outputDirectory": "build",
    "specVersion": 3,
    "schemes": ["http"],
    "basePath": "/api/v0"
  },
  "routes": {
    "routesDir": "build",
    "authenticationModule": "./src/key/express.ts"
  },
  "securityDefinitions": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "scopes": {
          "corporate": "corporate"
        }
      }
    }
}
